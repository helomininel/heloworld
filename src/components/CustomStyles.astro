---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-outfit), var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: var(--font-outfit), var(--font-inter), ui-sans-serif, system-ui, sans-serif;
    --aw-font-heading: var(--font-outfit), var(--font-inter), ui-sans-serif, system-ui, sans-serif;

    --aw-color-primary: #C85A32;
    --aw-color-secondary: #2A6564;
    --aw-color-accent: #C85A32;

    --aw-color-text-heading: #2E2825;
    --aw-color-text-default: #2E2825;
    --aw-color-text-muted: #6B5E57;
    --aw-color-bg-page: #FFF8F6;

    ::selection {
      background-color: #F6D3C6;
      color: #C85A32;
    }
  }
</style>
