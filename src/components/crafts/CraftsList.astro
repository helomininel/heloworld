---
import type { CollectionEntry } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';
import { craftCategories, craftCategoryIds, craftsCopy } from '~/utils/crafts';
import type { Lang } from '~/i18n/content';

interface Props {
  lang: Lang;
  crafts: CollectionEntry<'crafts'>[];
}

const { lang, crafts } = Astro.props;
const copy = craftsCopy[lang];
const labels = craftCategories[lang];
const base = lang === 'pt' ? '/pt/crochet' : '/crochet';

const filters = [{ id: 'all', label: copy.all }, ...craftCategoryIds.map((id) => ({ id, label: labels[id] }))];
---

<!-- Crafts grid with search and category filters (EN and PT share this markup). -->
<div class="max-w-6xl mx-auto px-6 py-12 w-full space-y-10">
  <!-- Crafts header (matches the Recipes page hero) -->
  <section class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6">
    <div class="flex flex-col max-w-2xl">
      <div class="flex items-center gap-1 mb-1">
        <span
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E8F3F1] border border-[#2A6564]/30 text-xs font-semibold text-[#2A6564]"
        >
          <span class="text-[#C85A32]">✦</span>
          <span>{copy.pill}</span>
        </span>
      </div>
      <h1
        class="text-[38px] md:text-[56px] leading-[46px] md:leading-[64px] tracking-[-0.02em] font-extrabold text-[#291710]"
      >
        {copy.title}
      </h1>
      <p class="text-[18px] leading-[28px] text-[#57423b] mt-1">{copy.intro}</p>
      <div class="flex flex-wrap gap-2 pt-2 text-xs font-semibold text-[#6B5E57]">
        <span class="px-3 py-1 rounded-full bg-white border border-[#F6D3C6]">● {crafts.length} {copy.patterns}</span>
        <span class="px-3 py-1 rounded-full bg-white border border-[#F6D3C6]"
          >● {new Set(crafts.map((c) => c.data.category)).size} {copy.categories}</span
        >
      </div>
    </div>
  </section>

  <!-- Search & Filters -->
  <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
    <div class="relative w-full md:w-80">
      <input
        id="craft-search"
        class="w-full pl-10 pr-4 py-2.5 rounded-full bg-white border border-[#F6D3C6] text-sm focus:outline-none focus:border-[#C85A32]"
        placeholder={copy.searchPlaceholder}
        type="text"
      />
      <span class="material-symbols-outlined absolute left-3.5 top-3 text-lg text-[#6B5E57]">search</span>
    </div>
    <div id="craft-filters" class="flex items-center gap-2 p-1.5 bg-[#fff1ec] rounded-full shadow-sm overflow-x-auto">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.id}
            class:list={[
              'px-4 py-1.5 rounded-full text-[13px] font-bold tracking-[0.03em] transition-all whitespace-nowrap',
              i === 0 ? 'bg-white text-[#9f3c16] shadow-sm' : 'text-[#57423b] hover:text-[#291710] hover:bg-[#ffe9e2]',
            ]}
          >
            {f.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Pattern Grid -->
  <div id="craft-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      crafts.map((c) => (
        <a
          class="craft-card group bg-white rounded-2xl border border-[#F6D3C6] overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between"
          href={getPermalink(`${base}/${c.id.split('/')[1]}`)}
          data-category={c.data.category}
          data-search={`${c.data.title} ${c.data.desc}`.toLowerCase()}
        >
          <div>
            <div class="h-44 overflow-hidden relative">
              {c.data.image ? (
                <img
                  alt={c.data.alt ?? c.data.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  src={c.data.image.src}
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-[#E8F3F1] via-[#FFF1EC] to-[#F6D3C6] flex items-center justify-center text-6xl">
                  🧶
                </div>
              )}
              <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-white/90 text-[11px] font-bold text-[#6B5E57]">
                {labels[c.data.category]}
              </span>
            </div>
            <div class="p-5 space-y-2">
              <h3 class="font-bold text-lg text-[#2E2825] group-hover:text-[#C85A32] transition-colors">
                {c.data.title}
              </h3>
              <p class="text-xs text-[#6B5E57] leading-relaxed">{c.data.desc}</p>
            </div>
          </div>
          <div class="p-5 pt-0 flex items-center justify-between">
            <span class="px-4 py-2 rounded-full bg-[#FFF1EC] text-xs font-semibold text-[#2E2825] group-hover:bg-[#F6D3C6] transition-colors">
              {copy.viewPattern}
            </span>
          </div>
        </a>
      ))
    }
  </div>
  <p id="craft-empty" class="hidden text-sm text-[#6B5E57] text-center py-8">{copy.empty}</p>
</div>

<script>
  // Binds search and filters to the current page's DOM. Runs on every
  // `astro:page-load` (view transitions replace the body, so listeners must be
  // re-attached; the `bound` marker prevents double-binding within one DOM).
  const initPage = () => {
    const search = document.getElementById('craft-search') as HTMLInputElement | null;
    const filterWrap = document.getElementById('craft-filters');
    if (filterWrap?.dataset.bound) return;
    if (filterWrap) filterWrap.dataset.bound = '1';

    const cards = document.querySelectorAll<HTMLElement>('.craft-card');
    const empty = document.getElementById('craft-empty');
    let active = 'all';

    const apply = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const okFilter = active === 'all' || card.dataset.category === active;
        const okSearch = !q || (card.dataset.search ?? '').includes(q);
        const show = okFilter && okSearch;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible > 0);
    };

    search?.addEventListener('input', apply);

    filterWrap?.addEventListener('click', (e) => {
      const pill = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]');
      if (!pill) return;
      active = pill.dataset.filter ?? 'all';
      filterWrap.querySelectorAll<HTMLElement>('[data-filter]').forEach((p) => {
        const on = p === pill;
        p.classList.toggle('bg-white', on);
        p.classList.toggle('text-[#9f3c16]', on);
        p.classList.toggle('shadow-sm', on);
        p.classList.toggle('text-[#57423b]', !on);
      });
      apply();
    });

    apply();
  };

  document.addEventListener('astro:page-load', initPage);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPage);
  else initPage();
</script>
