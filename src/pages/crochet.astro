---
import Layout from '~/layouts/PageLayout.astro';
import CraftsList from '~/components/crafts/CraftsList.astro';
import { getCollection } from 'astro:content';
import { craftsCopy } from '~/utils/crafts';

const crafts = await getCollection('crafts', ({ id }) => id.startsWith('en/'));

const metadata = {
  title: craftsCopy.en.metaTitle,
  description: craftsCopy.en.metaDescription,
};
---

<Layout metadata={metadata}>
  <CraftsList lang="en" crafts={crafts} />
</Layout>
