---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { socialUrls } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';
import headShot from '~/assets/images/head_shot.jpg';

const metadata = {
  title: 'HeloWorld — Personal Portfolio & Craft Hub',
  // The title already starts with "HeloWorld", so the '%s — HeloWorld'
  // template would duplicate it in the social share title.
  ignoreTitleTemplate: true,
  description:
    'Senior Data Analyst sharing data projects, creative hobbies, recipes, and little adventures along the way.',
};

const dataHref = getPermalink('/data');
const recipesHref = getPermalink('/recipes');
const craftsHref = getPermalink('/crochet');
const travelHref = getPermalink('/travel');
---

<Layout metadata={metadata}>
  <div class="max-w-6xl mx-auto px-6 py-6 md:py-8 w-full space-y-8">
    <section class="min-h-[calc(100vh-8rem)] flex flex-col gap-8 pt-2">
      <div class="space-y-4 relative w-full">
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E8F3F1] border border-[#2A6564]/30 text-xs font-semibold text-[#2A6564]"
        >
          <span class="text-[#C85A32]">✦</span>
          <span data-i18n="hero.badge">Exploring data, fibers &amp; flavors</span>
        </div>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[#2E2825] mt-6"
          data-i18n-html="hero.title"
        >
          Hello, world! <span class="text-[#C85A32]">I'm Helo.</span>
        </h1>
        <p class="text-xl md:text-2xl text-[#6B5E57] font-normal leading-relaxed" data-i18n="hero.subtitle">
          Welcome to my little corner of the internet, where I share what I learn, make, and discover.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
        <a
          class="cursor-pointer group p-6 rounded-2xl bg-white border border-[#99F6E4]/50 hover:border-[#0F766E] shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
          href={dataHref}
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-[#E6F4F1] text-[#0F766E] flex items-center justify-center mb-4 transition-transform group-hover:scale-110"
            >
              <span class="material-symbols-outlined text-2xl">query_stats</span>
            </div>
            <h3
              class="font-bold text-lg text-[#2E2825] group-hover:text-[#0F766E] transition-colors mb-2"
              data-i18n="cards.data.title"
            >
              Data &amp; Analytics
            </h3>
            <p class="text-xs text-[#6B5E57] leading-relaxed mb-4" data-i18n="cards.data.desc">
              Data projects, articles, and things I've learned along the way.
            </p>
          </div>
          <span
            class="text-xs font-bold text-[#0F766E] inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            data-i18n="cards.data.cta"
          >
            Browse projects & articles →
          </span>
        </a>

        <a
          class="cursor-pointer group p-6 rounded-2xl bg-white border border-[#FDBA74]/50 hover:border-[#C85A32] shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
          href={recipesHref}
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-[#FFEDD5] text-[#C85A32] flex items-center justify-center mb-4 transition-transform group-hover:scale-110"
            >
              <span class="material-symbols-outlined text-2xl">skillet</span>
            </div>
            <h3
              class="font-bold text-lg text-[#2E2825] group-hover:text-[#C85A32] transition-colors mb-2"
              data-i18n="cards.recipes.title"
            >
              Recipes
            </h3>
            <p class="text-xs text-[#6B5E57] leading-relaxed mb-4" data-i18n="cards.recipes.desc">
              Recipes I've tried, favorites I've collected, and kitchen experiments worth sharing.
            </p>
          </div>
          <span
            class="text-xs font-bold text-[#C85A32] inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            data-i18n="cards.recipes.cta"
          >
            Explore recipes →
          </span>
        </a>

        <a
          class="cursor-pointer group p-6 rounded-2xl bg-white border border-[#FECDD3]/60 hover:border-[#BE123C] shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
          href={craftsHref}
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-[#FFE4E6] text-[#BE123C] flex items-center justify-center mb-4 transition-transform group-hover:scale-110"
            >
              <span class="material-symbols-outlined text-2xl">gesture</span>
            </div>
            <h3
              class="font-bold text-lg text-[#2E2825] group-hover:text-[#BE123C] transition-colors mb-2"
              data-i18n="cards.crafts.title"
            >
              Crafts &amp; DIY
            </h3>
            <p class="text-xs text-[#6B5E57] leading-relaxed mb-4" data-i18n="cards.crafts.desc">
              Things I'm making, new hobbies I'm trying, and creative projects in progress.
            </p>
          </div>
          <span
            class="text-xs font-bold text-[#BE123C] inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            data-i18n="cards.crafts.cta"
          >
            View gallery →
          </span>
        </a>

        <a
          class="cursor-pointer group p-6 rounded-2xl bg-white border border-[#FDE68A]/60 hover:border-[#B45309] shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
          href={travelHref}
        >
          <div>
            <div
              class="w-12 h-12 rounded-xl bg-[#FEF3C7] text-[#B45309] flex items-center justify-center mb-4 transition-transform group-hover:scale-110"
            >
              <span class="material-symbols-outlined text-2xl">explore</span>
            </div>
            <h3
              class="font-bold text-lg text-[#2E2825] group-hover:text-[#B45309] transition-colors mb-2"
              data-i18n="cards.travel.title"
            >
              Travel Journal
            </h3>
            <p class="text-xs text-[#6B5E57] leading-relaxed mb-4" data-i18n="cards.travel.desc">
              Places I've visited, little discoveries, travel notes, and tips for future adventures.
            </p>
          </div>
          <span
            class="text-xs font-bold text-[#B45309] inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
            data-i18n="cards.travel.cta"
          >
            Read journeys →
          </span>
        </a>
      </div>
    </section>

    <section
      class="p-8 md:p-12 rounded-3xl bg-[#FFF1EC] border border-[#F6D3C6] flex flex-col items-center scroll-mt-24"
      id="about"
    >
      <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center w-full">
        <div
          class="relative w-64 h-64 md:w-80 md:h-80 shrink-0 rounded-2xl overflow-hidden shadow-md border-4 border-white bg-[#E8F3F1] flex items-center justify-center"
        >
          <Image alt="Helo" class="w-full h-full object-cover" layout="cover" format="webp" src={headShot} />
          <div
            class="absolute bottom-3 left-3 right-3 bg-white/95 backdrop-blur-sm rounded-full py-1.5 text-center text-xs font-semibold text-[#2E2825]"
            data-i18n="about.badge"
          >
            ● Senior Data Analyst
          </div>
        </div>
        <div class="space-y-4 flex-1">
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#2E2825]" data-i18n="about.title">A Little About Me</h2>
          <p class="text-base md:text-lg text-[#6B5E57] leading-relaxed" data-i18n="about.p1">
            I'm Helo, a Senior Data Analyst who spends a lot of time working with data, solving problems, and finding
            patterns. Outside work, I like trying new hobbies, making things, experimenting with recipes, and exploring
            new places.
          </p>
          <p class="text-base md:text-lg text-[#6B5E57] leading-relaxed" data-i18n="about.p2">
            HeloWorld is my little corner of the internet to document the things I learn and try along the way. Some
            projects might be carefully planned; others might just start with a bit of curiosity and a desire to try
            something new.
          </p>
          <p class="text-base md:text-lg text-[#6B5E57] leading-relaxed" data-i18n="about.p3">
            I'm not trying to be an expert at everything I share. I just enjoy learning and making things, and now I'd
            like to start documenting the process, too. Hopefully, I'll share something useful or inspiring with someone
            else along the way.
          </p>
        </div>
      </div>
      <div class="w-full border-t border-[#F6D3C6]/60 pt-6 mt-6">
        <div class="flex flex-wrap gap-2 items-center">
          <span
            class="bg-[#E6F4F1] border border-[#99F6E4] text-[#0F766E] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.sql">SQL</span
          >
          <span
            class="bg-[#E6F4F1] border border-[#99F6E4] text-[#0F766E] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.python">Python</span
          >
          <span
            class="bg-[#E6F4F1] border border-[#99F6E4] text-[#0F766E] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.storytelling">Storytelling</span
          >
          <span
            class="bg-[#FFEDD5] border border-[#FDBA74] text-[#C85A32] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.cooking">Cooking</span
          >
          <span
            class="bg-[#FFEDD5] border border-[#FDBA74] text-[#C85A32] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.baking">Baking</span
          >
          <span
            class="bg-[#FFEDD5] border border-[#FDBA74] text-[#C85A32] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.experimenting">Recipe Testing</span
          >
          <span
            class="bg-[#FFE4E6] border border-[#FECDD3] text-[#BE123C] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.crochet">Crochet</span
          >
          <span
            class="bg-[#FFE4E6] border border-[#FECDD3] text-[#BE123C] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.pottery">Pottery</span
          >
          <span
            class="bg-[#FFE4E6] border border-[#FECDD3] text-[#BE123C] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.scrapbooking">Scrapbooking</span
          >
          <span
            class="bg-[#FEF3C7] border border-[#FDE68A] text-[#B45309] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.planning">Planning trips</span
          >
          <span
            class="bg-[#FEF3C7] border border-[#FDE68A] text-[#B45309] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.traveling">Traveling</span
          >
          <span
            class="bg-[#FEF3C7] border border-[#FDE68A] text-[#B45309] text-xs font-semibold rounded-full px-3 py-1"
            data-i18n="tag.hiking">Hiking</span
          >
        </div>
      </div>
    </section>

    <section
      class="p-8 md:p-10 rounded-3xl bg-[#FFF1EC] border border-[#F6D3C6] flex flex-col md:flex-row items-center justify-between gap-6"
      id="connect"
    >
      <div class="space-y-1">
        <div class="text-xs font-bold text-[#C85A32] uppercase tracking-wide" data-i18n="connect.label">
          Open for collaborations &amp; chats
        </div>
        <h2 class="text-2xl md:text-3xl font-bold text-[#2E2825]" data-i18n="connect.title">Let's connect</h2>
        <p class="text-sm text-[#6B5E57] max-w-xl" data-i18n="connect.desc">
          Have a question about data, a recipe tip, a craft idea, or just want to say hi?<br />I'd love to hear from
          you.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          class="px-5 py-2.5 rounded-full bg-white border border-[#2A6564]/30 hover:border-[#2A6564] text-sm font-semibold text-[#2E2825] hover:text-[#2A6564] transition-all"
          href={socialUrls.github}
          rel="noopener noreferrer"
          target="_blank">GitHub</a
        >
        <a
          class="px-5 py-2.5 rounded-full bg-white border border-[#2A6564]/30 hover:border-[#2A6564] text-sm font-semibold text-[#2E2825] hover:text-[#2A6564] transition-all"
          href={socialUrls.linkedin}
          rel="noopener noreferrer"
          target="_blank">LinkedIn</a
        >
      </div>
    </section>
  </div>
</Layout>
