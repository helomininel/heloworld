---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Diário de Viagem',
};
---

<Layout metadata={metadata} lang="pt">
  <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 w-full">
    <section class="flex flex-col max-w-2xl">
      <div class="flex items-center gap-1 mb-1">
        <span
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E8F3F1] border border-[#2A6564]/30 text-xs font-semibold text-[#2A6564]"
        >
          <span class="text-[#C85A32]">✦</span>
          <span>Lugares & memórias</span>
        </span>
      </div>
      <h1
        class="text-[38px] md:text-[56px] leading-[46px] md:leading-[64px] tracking-[-0.02em] font-extrabold text-[#291710]"
      >
        Diário de Viagens
      </h1>
      <p class="text-[18px] leading-[28px] text-[#57423b] mt-1">Em breve!</p>
    </section>
  </div>
</Layout>
