---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Dados & Projetos',
  description: 'Análises, código e artigos — em breve em português.',
};
---

<Layout metadata={metadata} lang="pt">
  <div class="max-w-6xl mx-auto px-6 py-12 w-full space-y-10">
    <div class="p-8 rounded-3xl bg-[#FFF1EC] border border-[#F6D3C6] space-y-3">
      <div class="text-xs font-bold text-[#C85A32] flex items-center gap-1.5">
        <span class="material-symbols-outlined text-sm">analytics</span> ● ANÁLISE, CÓDIGO &amp; ESSAYS
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold text-[#2E2825]">Dados &amp; Projetos</h1>
      <p class="text-sm md:text-base text-[#6B5E57] max-w-2xl">
        Artigos sobre análise de dados, curiosidade de machine learning e ferramentas open-source. Esta secção estará
        disponível em português em breve.
      </p>
    </div>

    <div
      class="p-8 rounded-3xl bg-white border border-[#F6D3C6] flex flex-col md:flex-row items-center justify-between gap-6"
    >
      <p class="text-sm text-[#6B5E57] max-w-xl">Enquanto isso, podes ler os artigos na versão inglesa do site.</p>
      <a
        class="px-5 py-2.5 rounded-full bg-[#C85A32] text-white text-sm font-medium hover:bg-[#b04a25] transition-colors shrink-0"
        href={getPermalink('/blog')}
      >
        Ver artigos (EN) →
      </a>
    </div>
  </div>
</Layout>
