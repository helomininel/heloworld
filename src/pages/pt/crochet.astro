---
import Layout from '~/layouts/PageLayout.astro';
import CraftsList from '~/components/crafts/CraftsList.astro';
import { getCollection } from 'astro:content';
import { craftsCopy } from '~/utils/crafts';

const crafts = await getCollection('crafts', ({ id }) => id.startsWith('pt/'));

const metadata = {
  title: craftsCopy.pt.metaTitle,
  description: craftsCopy.pt.metaDescription,
};
---

<Layout metadata={metadata} lang="pt">
  <CraftsList lang="pt" crafts={crafts} />
</Layout>
